---

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>RSS Reader</title>
		<!--
			is:global, not scoped: most of this app's DOM (#post-list/#feed-list
			items) is created client-side by app.ts via document.createElement,
			which Astro's scoped-style attribute stamping never reaches (see the
			Obsidian decision log for the bug this was learned from).
		-->
		<style is:global>
			:root {
				--font-serif: "Iowan Old Style", "Palatino Linotype", Palatino, "URW Palladio L", Georgia, serif;
				--font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

				--bg: #faf8f4;
				--fg: #22201c;
				--muted: #79715f;
				--border: #e4ded0;
				--control-bg: #f2eee4;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #18160f;
					--fg: #eae5d9;
					--muted: #948c78;
					--border: #332e22;
					--control-bg: #221f17;
				}
			}

			* {
				box-sizing: border-box;
			}

			html {
				background: var(--bg);
			}

			body {
				background: var(--bg);
				color: var(--fg);
				font-family: var(--font-sans);
				line-height: 1.5;
				max-width: 40rem;
				margin: 0 auto;
				padding: 3rem 1.5rem 5rem;
			}

			a {
				color: inherit;
			}

			a:visited {
				color: inherit;
			}

			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.masthead {
				margin-bottom: 2.5rem;
			}

			.masthead h1 {
				font-family: var(--font-serif);
				font-style: italic;
				font-weight: 400;
				font-size: 1.5rem;
				letter-spacing: 0.02em;
				margin: 0 0 0.6rem;
			}

			.masthead hr {
				border: none;
				border-top: 1px solid var(--border);
				margin: 0;
			}

			#posts-status {
				font-family: var(--font-sans);
				font-size: 0.8rem;
				color: var(--muted);
				margin: 0 0 1.25rem;
			}

			.catch-up {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.5rem;
				font-size: 0.8rem;
				color: var(--muted);
				margin-bottom: 2.25rem;
			}

			.catch-up label {
				white-space: nowrap;
			}

			.catch-up input,
			.catch-up button {
				font: inherit;
				color: var(--fg);
				background: var(--control-bg);
				border: 1px solid var(--border);
				border-radius: 3px;
				padding: 0.3rem 0.5rem;
			}

			.catch-up button {
				cursor: pointer;
			}

			.catch-up button:hover {
				border-color: var(--muted);
			}

			#post-list li {
				padding: 1rem 0;
				border-bottom: 1px solid var(--border);
			}

			#post-list li:first-child {
				padding-top: 0;
			}

			#post-list a {
				display: block;
				font-family: var(--font-serif);
				font-size: 1.05rem;
				line-height: 1.4;
				text-decoration: none;
			}

			#post-list a:hover {
				text-decoration: underline;
			}

			#post-list .meta {
				display: block;
				margin-top: 0.3rem;
				font-family: var(--font-sans);
				font-size: 0.78rem;
				color: var(--muted);
			}

			#post-list .feed-name::after {
				content: " · ";
			}

			.subscriptions {
				margin-top: 4rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border);
				font-size: 0.8rem;
				color: var(--muted);
			}

			.subscriptions h2 {
				font-family: var(--font-sans);
				font-weight: 600;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--muted);
				margin: 0 0 0.75rem;
			}

			#feed-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 0.9rem;
				margin-bottom: 1.25rem;
			}

			/*
				color: inherit so a feed whose homepage is known looks identical
				to one whose isn't — the list stays uniform instead of turning
				into a patchwork of link-blue and plain text as feeds resolve.
			*/
			#feed-list a {
				color: inherit;
				text-decoration: none;
			}

			#feed-list a:hover {
				text-decoration: underline;
			}

			.import-opml {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.import-opml input[type="file"] {
				font: inherit;
				font-size: 0.8rem;
				color: var(--muted);
			}

			#status {
				margin: 0.5rem 0 0;
			}

			/*
				Asks before pushing a watermark from a degraded load (some feeds
				failed to fetch) — see "a degraded load asks before pushing the
				watermark" in the Obsidian decision log. Shown at most once per
				load; declining costs nothing, since the next clean load pushes
				the accumulated watermark on its own.
			*/
			/*
				:not([hidden]), not a bare selector: the `hidden` attribute's
				built-in `display: none` is a user-agent style, which any
				author `display` declaration overrides regardless of
				specificity. Without this, el.hidden = true (used below and in
				app.ts) would toggle the attribute but change nothing on screen.
			*/
			.sync-banner:not([hidden]) {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
				font-size: 0.8rem;
				color: var(--fg);
				background: var(--control-bg);
				border: 1px solid var(--border);
				border-radius: 4px;
				padding: 0.75rem 1rem;
				margin-bottom: 2.25rem;
			}

			.sync-banner p {
				margin: 0;
				flex: 1 1 16rem;
			}

			.sync-banner-actions {
				display: flex;
				gap: 0.5rem;
				flex-shrink: 0;
			}

			.sync-banner-actions button {
				font: inherit;
				color: var(--fg);
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: 3px;
				padding: 0.3rem 0.6rem;
				cursor: pointer;
			}

			.sync-banner-actions button:hover {
				border-color: var(--muted);
			}

			.sync-setup {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border);
				font-size: 0.8rem;
				color: var(--muted);
			}

			.sync-setup h2 {
				font-family: var(--font-sans);
				font-weight: 600;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--muted);
				margin: 0 0 0.75rem;
			}

			.sync-setup button {
				font: inherit;
				color: var(--fg);
				background: var(--control-bg);
				border: 1px solid var(--border);
				border-radius: 3px;
				padding: 0.4rem 0.7rem;
				cursor: pointer;
			}

			.sync-setup button:hover {
				border-color: var(--muted);
			}

			.sync-setup button:disabled {
				cursor: default;
				opacity: 0.6;
			}

			/* :not([hidden]) — see the .sync-banner rule above for why. */
			.pairing-panel:not([hidden]) {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				align-items: flex-start;
				margin-top: 1rem;
				padding: 1rem;
				background: var(--control-bg);
				border: 1px solid var(--border);
				border-radius: 4px;
			}

			.pairing-panel canvas {
				background: #fff;
				border-radius: 3px;
			}

			.pairing-panel-details {
				flex: 1 1 14rem;
			}

			.pairing-panel-details p {
				margin: 0 0 0.5rem;
			}

			.pairing-code {
				font-family: var(--font-sans);
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				color: var(--fg);
			}

			#sync-setup-status {
				margin: 0.5rem 0 0;
			}
		</style>
	</head>
	<body>
		<header class="masthead">
			<h1>RSS Reader</h1>
			<hr />
		</header>

		<!-- Main content: posts from all subscribed feeds. -->
		<main>
			<p id="posts-status"></p>
			<!--
				Degraded-load consent banner. Appears at most once per load, only
				when some feed failed and the local watermark would otherwise sit
				unpushed with no explanation. See app.ts's pushWatermarkIfAllowed.
			-->
			<div id="sync-banner" class="sync-banner" role="alert" hidden>
				<p id="sync-banner-message"></p>
				<div class="sync-banner-actions">
					<button id="sync-banner-push" type="button">Push anyway</button>
					<button id="sync-banner-dismiss" type="button">Keep local</button>
				</div>
			</div>
			<!--
				One-time escape hatch for a backlog you have no intention of reading
				through in order (e.g. right after importing an OPML with years of
				history). Sets the watermark to a date you pick — does not change
				the normal click-to-advance behavior at all.
			-->
			<div class="catch-up">
				<label for="catch-up-date">Mark everything read before</label>
				<input type="date" id="catch-up-date" />
				<button id="catch-up-button" type="button">Catch up</button>
			</div>
			<ul id="post-list"></ul>
		</main>

		<!--
			Subscription management, deliberately unstyled/secondary for now.
			Eventually this becomes a "+" icon opening an add-feed/import-OPML flow,
			tucked away from the main posts view instead of sitting above it.
		-->
		<section class="subscriptions">
			<h2>Subscribed feeds</h2>
			<ul id="feed-list"></ul>
			<div class="import-opml">
				<label for="opml-input">Import OPML file</label>
				<input type="file" id="opml-input" accept=".opml,.xml,text/xml,text/x-opml" />
			</div>
			<p id="status"></p>
		</section>

		<!--
			Sync is opt-in: reading position and feeds stay local until a second
			device is paired. The button's label and this panel are driven entirely
			by app.ts — see the "device token is the paired flag" note in db.ts.
		-->
		<section class="sync-setup">
			<h2>Sync across devices</h2>
			<button id="sync-setup-button" type="button">Set up sync</button>
			<div id="pairing-panel" class="pairing-panel" hidden>
				<canvas id="pairing-qr" width="200" height="200"></canvas>
				<div class="pairing-panel-details">
					<p>
						Scan this with your other device's camera, or open
						<code id="pairing-url"></code> there and enter code
						<span id="pairing-code" class="pairing-code"></span>
					</p>
					<p id="pairing-expiry"></p>
					<button id="pairing-done" type="button">Done</button>
				</div>
			</div>
			<p id="sync-setup-status"></p>
		</section>

		<script src="../scripts/app.ts"></script>
	</body>
</html>
