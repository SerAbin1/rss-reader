---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>RSS Reader</title>
	</head>
	<body>
		<h1>RSS Reader</h1>

		<!-- Main content: posts from all subscribed feeds. -->
		<section>
			<p id="posts-status"></p>
			<!--
				One-time escape hatch for a backlog you have no intention of reading
				through in order (e.g. right after importing an OPML with years of
				history). Sets the watermark to a date you pick — does not change
				the normal click-to-advance behavior at all.
			-->
			<label for="catch-up-date">Mark everything read up to</label>
			<input type="date" id="catch-up-date" />
			<button id="catch-up-button" type="button">Catch up</button>
			<ul id="post-list"></ul>
		</section>

		<!--
			Subscription management, deliberately unstyled/secondary for now.
			Eventually this becomes a "+" icon opening an add-feed/import-OPML flow,
			tucked away from the main posts view instead of sitting above it.
		-->
		<section>
			<h2>Subscribed feeds</h2>
			<ul id="feed-list"></ul>
			<label for="opml-input">Import OPML file</label>
			<input type="file" id="opml-input" accept=".opml,.xml,text/xml,text/x-opml" />
			<p id="status"></p>
		</section>

		<script src="../scripts/app.ts"></script>
	</body>
</html>
